domain CrimpM[I, V, S]  {

  function crimpM(r: Receiver[I], m: Mapping[V, S], op: Operator[S]): CrimpM[I, V, S]

  function crimpApplyM(f: Fuel, crh: Int, c: CrimpM[I, V, S], fs: Set[I]): S

  function crimpApplyDummyM(a: S): Bool

  function setEqDummyM(b: Bool): Bool

  function getreceiverM(c: CrimpM[I, V, S]): Receiver[I]

  function getoperatorM(c: CrimpM[I, V, S]): Operator[S]

  function getmappingM(c: CrimpM[I, V, S]): Mapping[V, S]

  function rHeapElemM(crh: Int, c: CrimpM[I, V, S], a: I): S

  function triggerDeleteBlockM(applyC: S, block: Set[I]): Bool

  function triggerDeleteKey1M(applyC: S, key: I): Bool

  function getFieldIDM(c: CrimpM[I, V, S]): Int

  function skExtM(c: CrimpM[I, V, S], hfA1: S, hfA2: S): I

  function triggerExtM(hfA1: S, hfA2: S): Bool

  axiom applyCrimpFuelEqM {
    (forall __crimp_f: Fuel, __crimp_crh: Int, __crimp_c: CrimpM[I, V, S],
    __crimp_fs: Set[I] ::
      { (crimpApplyM(succ(__crimp_f), __crimp_crh, __crimp_c, __crimp_fs): S) }
      (crimpApplyM(succ(__crimp_f), __crimp_crh, __crimp_c, __crimp_fs): S) ==
      (crimpApplyM(__crimp_f, __crimp_crh, __crimp_c, __crimp_fs): S))
  }

  axiom _invAxCrimpM {
    (forall __crimp_r: Receiver[I], __crimp_m: Mapping[V, S], __crimp_o: Operator[S] ::
      { (crimpM(__crimp_r, __crimp_m, __crimp_o): CrimpM[I, V, S]) }
      (getreceiverM((crimpM(__crimp_r, __crimp_m, __crimp_o): CrimpM[I, V, S])): Receiver[I]) ==
      __crimp_r &&
      ((getmappingM((crimpM(__crimp_r, __crimp_m, __crimp_o): CrimpM[I, V, S])): Mapping[V, S]) ==
      __crimp_m &&
      (getoperatorM((crimpM(__crimp_r, __crimp_m, __crimp_o): CrimpM[I, V, S])): Operator[S]) ==
      __crimp_o))
  }

  axiom _emptyCrimpM {
    (forall __crimp_f: Fuel, __crimp_crh: Int, __crimp_c: CrimpM[I, V, S],
    __crimp_fs: Set[I] ::
      { (crimpApplyM(__crimp_f, __crimp_crh, __crimp_c, __crimp_fs): S) }
      __crimp_fs == Set[I]() ==>
      __crimp_fs == Set[I]() &&
      (crimpApplyM(__crimp_f, __crimp_crh, __crimp_c, __crimp_fs): S) ==
      (opGetIden((getoperatorM(__crimp_c): Operator[S])): S))
  }

  axiom _singletonM {
    (forall __crimp_f: Fuel, __crimp_crh: Int, __crimp_c: CrimpM[I, V, S],
    __crimp_elem: I ::
      { (crimpApplyM(__crimp_f, __crimp_crh, __crimp_c, Set(__crimp_elem)): S),
      (rHeapElemM(__crimp_crh, __crimp_c, __crimp_elem): S) }
      (crimpApplyM(__crimp_f, __crimp_crh, __crimp_c, Set(__crimp_elem)): S) ==
      (rHeapElemM(__crimp_crh, __crimp_c, __crimp_elem): S))
  }

  axiom _dropOne1M {
    (forall __crimp_f: Fuel, __crimp_crh: Int, __crimp_c: CrimpM[I, V, S],
    __crimp_fs: Set[I], __crimp_key: I ::
      { (triggerDeleteKey1M((crimpApplyM(succ(__crimp_f), __crimp_crh, __crimp_c,
      __crimp_fs): S), __crimp_key): Bool), (rHeapElemM(__crimp_crh, __crimp_c,
      __crimp_key): S) }
      (__crimp_key in __crimp_fs) ==>
      (__crimp_key in __crimp_fs) &&
      (crimpApplyM(succ(__crimp_f), __crimp_crh, __crimp_c, __crimp_fs): S) ==
      (opApply((getoperatorM(__crimp_c): Operator[S]), (crimpApplyM(__crimp_f,
      __crimp_crh, __crimp_c, (setDelete(__crimp_fs, Set(__crimp_key)): Set[I])): S),
      (rHeapElemM(__crimp_crh, __crimp_c, __crimp_key): S)): S))
  }

  axiom _loseManyM {
    (forall __crimp_f: Fuel, __crimp_crh: Int, __crimp_c: CrimpM[I, V, S],
    __crimp_fs: Set[I], __crimp_keys: Set[I] ::
      { (triggerDeleteBlockM((crimpApplyM(succ(__crimp_f), __crimp_crh, __crimp_c,
      __crimp_fs): S), __crimp_keys): Bool) }
      (__crimp_keys subset __crimp_fs) ==>
      (__crimp_keys subset __crimp_fs) &&
      (crimpApplyM(succ(__crimp_f), __crimp_crh, __crimp_c, __crimp_fs): S) ==
      (opApply((getoperatorM(__crimp_c): Operator[S]), (crimpApplyM(__crimp_f,
      __crimp_crh, __crimp_c, (setDelete(__crimp_fs, __crimp_keys): Set[I])): S),
      (crimpApplyM(__crimp_f, __crimp_crh, __crimp_c, __crimp_keys): S)): S))
  }

  axiom _setExtEqM {
    (forall __crimp_f1: Fuel, __crimp_f2: Fuel, __crimp_crh: Int, __crimp_c: CrimpM[I, V, S],
    __crimp_fs1: Set[I], __crimp_fs2: Set[I] ::
      { (crimpApplyM(__crimp_f1, __crimp_crh, __crimp_c, __crimp_fs1): S),
      (crimpApplyM(__crimp_f2, __crimp_crh, __crimp_c, __crimp_fs2): S) }
      (setEqDummyM(__crimp_fs1 == __crimp_fs2): Bool))
  }

  axiom _disjUnionM {
    (forall __crimp_f1: Fuel, __crimp_f2: Fuel, __crimp_crh: Int, __crimp_c: CrimpM[I, V, S],
    __crimp_fs1: Set[I], __crimp_fs2: Set[I], __crimp_dus: Set[I] ::
      { (crimpApplyM(__crimp_f1, __crimp_crh, __crimp_c, __crimp_fs1): S),
      (crimpApplyM(__crimp_f2, __crimp_crh, __crimp_c, __crimp_fs2): S),
      (disjUnionEq(__crimp_fs1, __crimp_fs2, __crimp_dus): Bool) }
      (disjUnionEq(__crimp_fs1, __crimp_fs2, __crimp_dus): Bool) ==>
      (crimpApplyM(__crimp_f1, __crimp_crh, __crimp_c, __crimp_dus): S) ==
      (opApply((getoperatorM(__crimp_c): Operator[S]), (crimpApplyM(__crimp_f1,
      __crimp_crh, __crimp_c, __crimp_fs1): S), (crimpApplyM(__crimp_f2,
      __crimp_crh, __crimp_c, __crimp_fs2): S)): S) &&
      (crimpApplyM(__crimp_f2, __crimp_crh, __crimp_c, __crimp_dus): S) ==
      (opApply((getoperatorM(__crimp_c): Operator[S]), (crimpApplyM(__crimp_f1,
      __crimp_crh, __crimp_c, __crimp_fs1): S), (crimpApplyM(__crimp_f2,
      __crimp_crh, __crimp_c, __crimp_fs2): S)): S))
  }

  axiom _trigExtensionalityM {
    (forall __crimp_f1: Fuel, __crimp_f2: Fuel, __crimp_crh_old: Int, __crimp_crh_new: Int,
    __crimp_c: CrimpM[I, V, S], __crimp_fs: Set[I] ::
      { (crimpApplyM(__crimp_f1, __crimp_crh_old, __crimp_c, __crimp_fs): S),
      (crimpApplyM(__crimp_f2, __crimp_crh_new, __crimp_c, __crimp_fs): S) }
      (triggerExtM((crimpApplyM(__crimp_f1, __crimp_crh_old, __crimp_c,
      __crimp_fs): S), (crimpApplyM(__crimp_f2, __crimp_crh_new, __crimp_c,
      __crimp_fs): S)): Bool))
  }

  axiom _extensionalityM {
    (forall __crimp_f1: Fuel, __crimp_f2: Fuel, __crimp_crh_old: Int, __crimp_crh_new: Int,
    __crimp_c: CrimpM[I, V, S], __crimp_fs: Set[I] ::
      { (triggerExtM((crimpApplyM(__crimp_f1, __crimp_crh_old, __crimp_c,
      __crimp_fs): S), (crimpApplyM(__crimp_f2, __crimp_crh_new, __crimp_c,
      __crimp_fs): S)): Bool) }
      __crimp_crh_old < __crimp_crh_new ==>
      (crimpApplyM(__crimp_f1, __crimp_crh_old, __crimp_c, __crimp_fs): S) ==
      (crimpApplyM(__crimp_f2, __crimp_crh_new, __crimp_c, __crimp_fs): S) ||
      ((((skExtM(__crimp_c, (crimpApplyM(__crimp_f1, __crimp_crh_old, __crimp_c,
      __crimp_fs): S), (crimpApplyM(__crimp_f2, __crimp_crh_new, __crimp_c,
      __crimp_fs): S)): I) in
      __crimp_fs) ==>
      (rHeapElemM(__crimp_crh_old, __crimp_c, (skExtM(__crimp_c, (crimpApplyM(__crimp_f1,
      __crimp_crh_old, __crimp_c, __crimp_fs): S), (crimpApplyM(__crimp_f2,
      __crimp_crh_new, __crimp_c, __crimp_fs): S)): I)): S) ==
      (rHeapElemM(__crimp_crh_new, __crimp_c, (skExtM(__crimp_c, (crimpApplyM(__crimp_f1,
      __crimp_crh_old, __crimp_c, __crimp_fs): S), (crimpApplyM(__crimp_f2,
      __crimp_crh_new, __crimp_c, __crimp_fs): S)): I)): S)) ==>
      (crimpApplyM(__crimp_f1, __crimp_crh_old, __crimp_c, __crimp_fs): S) ==
      (crimpApplyM(__crimp_f2, __crimp_crh_new, __crimp_c, __crimp_fs): S)))
  }
}