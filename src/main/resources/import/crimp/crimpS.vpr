domain CrimpS[I, V, S]  {

  function crimpS(r: Receiver[I], m: Mapping[V, S], op: Operator[S], fid: Int): CrimpS[I, V, S]

  function crimpApplyS(f: Fuel, crh: Int, c: CrimpS[I, V, S], fs: Set[I]): S

  function crimpApplyDummyS(a: S): Bool

  function setEqDummyS(b: Bool): Bool

  function getreceiverS(c: CrimpS[I, V, S]): Receiver[I]

  function getoperatorS(c: CrimpS[I, V, S]): Operator[S]

  function getmappingS(c: CrimpS[I, V, S]): Mapping[V, S]

  function crHeapElemS(crh: Int, c: CrimpS[I, V, S], a: I): S

  function triggerDeleteBlockS(applyC: S, block: Set[I]): Bool

  function triggerDeleteKey1S(applyC: S, key: I): Bool

  function getFieldIDS(c: CrimpS[I, V, S]): Int

  function skExtS(c: CrimpS[I, V, S], hfA1: S, hfA2: S): I

  function triggerExtS(hfA1: S, hfA2: S): Bool

  axiom applyCrimpFuelEqS {
    (forall __crimp_f: Fuel, __crimp_crh: Int, __crimp_c: CrimpS[I, V, S],
    __crimp_fs: Set[I] ::
      { (crimpApplyS(succ(__crimp_f), __crimp_crh, __crimp_c, __crimp_fs): S) }
      (crimpApplyS(succ(__crimp_f), __crimp_crh, __crimp_c, __crimp_fs): S) ==
      (crimpApplyS(__crimp_f, __crimp_crh, __crimp_c, __crimp_fs): S))
  }

  axiom _invAxCrimpS {
    (forall __crimp_r: Receiver[I], __crimp_m: Mapping[V, S], __crimp_o: Operator[S], __crimp_fid: Int ::
      { (crimpS(__crimp_r, __crimp_m, __crimp_o, __crimp_fid): CrimpS[I, V, S]) }
      (getreceiverS((crimpS(__crimp_r, __crimp_m, __crimp_o, __crimp_fid): CrimpS[I, V, S])): Receiver[I]) ==
      __crimp_r &&
      ((getmappingS((crimpS(__crimp_r, __crimp_m, __crimp_o, __crimp_fid): CrimpS[I, V, S])): Mapping[V, S]) ==
      __crimp_m &&
      ((getoperatorS((crimpS(__crimp_r, __crimp_m, __crimp_o, __crimp_fid): CrimpS[I, V, S])): Operator[S]) ==
      __crimp_o) &&
      (getFieldIDS((crimpS(__crimp_r, __crimp_m, __crimp_o, __crimp_fid): CrimpS[I, V, S])): Int) ==
      __crimp_fid))
  }

  axiom _singletonS {
    (forall __crimp_f: Fuel, __crimp_crh: Int, __crimp_c: CrimpS[I, V, S],
    __crimp_elem: I ::
      { (crimpApplyS(__crimp_f, __crimp_crh, __crimp_c, Set(__crimp_elem)): S),
      (crHeapElemS(__crimp_crh, __crimp_c, __crimp_elem): S) }
      (crimpApplyS(__crimp_f, __crimp_crh, __crimp_c, Set(__crimp_elem)): S) ==
      (crHeapElemS(__crimp_crh, __crimp_c, __crimp_elem): S))
  }

  axiom _dropOne1S {
    (forall __crimp_f: Fuel, __crimp_crh: Int, __crimp_c: CrimpS[I, V, S],
    __crimp_fs: Set[I], __crimp_key: I ::
      { (triggerDeleteKey1S((crimpApplyS(succ(__crimp_f), __crimp_crh, __crimp_c,
      __crimp_fs): S), __crimp_key): Bool), (crHeapElemS(__crimp_crh, __crimp_c,
      __crimp_key): S) }
      (__crimp_key in __crimp_fs) && __crimp_fs != Set(__crimp_key) ==>
      (__crimp_key in __crimp_fs) && __crimp_fs != Set(__crimp_key) &&
      (crimpApplyS(succ(__crimp_f), __crimp_crh, __crimp_c, __crimp_fs): S) ==
      (opApply((getoperatorS(__crimp_c): Operator[S]), (crimpApplyS(__crimp_f,
      __crimp_crh, __crimp_c, (setDelete(__crimp_fs, Set(__crimp_key)): Set[I])): S),
      (crHeapElemS(__crimp_crh, __crimp_c, __crimp_key): S)): S))
  }

  axiom _loseManyS {
    (forall __crimp_f: Fuel, __crimp_crh: Int, __crimp_c: CrimpS[I, V, S],
    __crimp_fs: Set[I], __crimp_keys: Set[I] ::
      { (triggerDeleteBlockS((crimpApplyS(succ(__crimp_f), __crimp_crh, __crimp_c,
      __crimp_fs): S), __crimp_keys): Bool) }
      (__crimp_keys subset __crimp_fs) && __crimp_keys != __crimp_fs ==>
      (__crimp_keys subset __crimp_fs) && __crimp_keys != __crimp_fs &&
      (crimpApplyS(succ(__crimp_f), __crimp_crh, __crimp_c, __crimp_fs): S) ==
      (opApply((getoperatorS(__crimp_c): Operator[S]), (crimpApplyS(__crimp_f,
      __crimp_crh, __crimp_c, (setDelete(__crimp_fs, __crimp_keys): Set[I])): S),
      (crimpApplyS(__crimp_f, __crimp_crh, __crimp_c, __crimp_keys): S)): S))
  }

  axiom _setExtEqS {
    (forall __crimp_f1: Fuel, __crimp_f2: Fuel, __crimp_crh: Int, __crimp_c: CrimpS[I, V, S],
    __crimp_fs1: Set[I], __crimp_fs2: Set[I] ::
      { (crimpApplyS(__crimp_f1, __crimp_crh, __crimp_c, __crimp_fs1): S),
      (crimpApplyS(__crimp_f2, __crimp_crh, __crimp_c, __crimp_fs2): S) }
      (setEqDummyS(__crimp_fs1 == __crimp_fs2): Bool))
  }

  axiom _disjUnionS {
    (forall __crimp_f1: Fuel, __crimp_f2: Fuel, __crimp_crh: Int, __crimp_c: CrimpS[I, V, S],
    __crimp_fs1: Set[I], __crimp_fs2: Set[I], __crimp_dus: Set[I] ::
      { (crimpApplyS(__crimp_f1, __crimp_crh, __crimp_c, __crimp_fs1): S),
      (crimpApplyS(__crimp_f2, __crimp_crh, __crimp_c, __crimp_fs2): S),
      (disjUnionEq(__crimp_fs1, __crimp_fs2, __crimp_dus): Bool) }
      (disjUnionEq(__crimp_fs1, __crimp_fs2, __crimp_dus): Bool) &&
      (__crimp_fs1 != Set[I]() && __crimp_fs2 != Set[I]()) ==>
      (crimpApplyS(__crimp_f1, __crimp_crh, __crimp_c, __crimp_dus): S) ==
      (opApply((getoperatorS(__crimp_c): Operator[S]), (crimpApplyS(__crimp_f1,
      __crimp_crh, __crimp_c, __crimp_fs1): S), (crimpApplyS(__crimp_f2,
      __crimp_crh, __crimp_c, __crimp_fs2): S)): S) &&
      (crimpApplyS(__crimp_f2, __crimp_crh, __crimp_c, __crimp_dus): S) ==
      (opApply((getoperatorS(__crimp_c): Operator[S]), (crimpApplyS(__crimp_f1,
      __crimp_crh, __crimp_c, __crimp_fs1): S), (crimpApplyS(__crimp_f2,
      __crimp_crh, __crimp_c, __crimp_fs2): S)): S))
  }

  axiom _trigExtensionalityS {
    (forall __crimp_f1: Fuel, __crimp_f2: Fuel, __crimp_crh_old: Int, __crimp_crh_new: Int,
    __crimp_c: CrimpS[I, V, S], __crimp_fs: Set[I] ::
      { (crimpApplyS(__crimp_f1, __crimp_crh_old, __crimp_c, __crimp_fs): S),
      (crimpApplyS(__crimp_f2, __crimp_crh_new, __crimp_c, __crimp_fs): S) }
      (triggerExtS((crimpApplyS(__crimp_f1, __crimp_crh_old, __crimp_c,
      __crimp_fs): S), (crimpApplyS(__crimp_f2, __crimp_crh_new, __crimp_c,
      __crimp_fs): S)): Bool))
  }

  axiom _extensionalityS {
    (forall __crimp_f1: Fuel, __crimp_f2: Fuel, __crimp_crh_old: Int, __crimp_crh_new: Int,
    __crimp_c: CrimpS[I, V, S], __crimp_fs: Set[I] ::
      { (triggerExtS((crimpApplyS(__crimp_f1, __crimp_crh_old, __crimp_c,
      __crimp_fs): S), (crimpApplyS(__crimp_f2, __crimp_crh_new, __crimp_c,
      __crimp_fs): S)): Bool) }
      __crimp_crh_old < __crimp_crh_new ==>
      (crimpApplyS(__crimp_f1, __crimp_crh_old, __crimp_c, __crimp_fs): S) ==
      (crimpApplyS(__crimp_f2, __crimp_crh_new, __crimp_c, __crimp_fs): S) ||
      (__crimp_fs != Set[I]() &&
      (((skExtS(__crimp_c, (crimpApplyS(__crimp_f1, __crimp_crh_old, __crimp_c,
      __crimp_fs): S), (crimpApplyS(__crimp_f2, __crimp_crh_new, __crimp_c,
      __crimp_fs): S)): I) in
      __crimp_fs) ==>
      (crHeapElemS(__crimp_crh_old, __crimp_c, (skExtS(__crimp_c, (crimpApplyS(__crimp_f1,
      __crimp_crh_old, __crimp_c, __crimp_fs): S), (crimpApplyS(__crimp_f2,
      __crimp_crh_new, __crimp_c, __crimp_fs): S)): I)): S) ==
      (crHeapElemS(__crimp_crh_new, __crimp_c, (skExtS(__crimp_c, (crimpApplyS(__crimp_f1,
      __crimp_crh_old, __crimp_c, __crimp_fs): S), (crimpApplyS(__crimp_f2,
      __crimp_crh_new, __crimp_c, __crimp_fs): S)): I)): S)) ==>
      (crimpApplyS(__crimp_f1, __crimp_crh_old, __crimp_c, __crimp_fs): S) ==
      (crimpApplyS(__crimp_f2, __crimp_crh_new, __crimp_c, __crimp_fs): S)))
  }
}