domain Fuel  {

  function succ(f: Fuel): Fuel

  function zero(): Fuel
}

domain Receiver[I]  {

  function recApply(r: Receiver[I], a: I): Ref

  function recInv(rec: Receiver[I], ref: Ref): I

  function filterReceiverGood(f: Set[I], r: Receiver[I]): Bool

  function subsetNotInRefs(f1: Set[I], r: Receiver[I], lostR: Set[Ref]): Set[I]

  function idxNotInRefs(a: I, r: Receiver[I], domR: Set[Ref]): Bool

  axiom _inverse_receiver {
    (forall __crimp_a: I, __crimp_f: Set[I], __crimp_r: Receiver[I] ::
      { (recApply(__crimp_r, __crimp_a): Ref), (filterReceiverGood(__crimp_f,
      __crimp_r): Bool) }
      { (filterReceiverGood(__crimp_f, __crimp_r): Bool), (__crimp_a in
      __crimp_f) }
      (filterReceiverGood(__crimp_f, __crimp_r): Bool) &&
      (__crimp_a in __crimp_f) ==>
      (filterReceiverGood(__crimp_f, __crimp_r): Bool) &&
      ((__crimp_a in __crimp_f) &&
      (recInv(__crimp_r, (recApply(__crimp_r, __crimp_a): Ref)): I) ==
      __crimp_a))
  }

  axiom _inverse_receiver1 {
    (forall __crimp_ref: Ref, __crimp_f: Set[I], __crimp_r: Receiver[I] ::
      { (filterReceiverGood(__crimp_f, __crimp_r): Bool), (recInv(__crimp_r,
      __crimp_ref): I) }
      (filterReceiverGood(__crimp_f, __crimp_r): Bool) &&
      ((recInv(__crimp_r, __crimp_ref): I) in __crimp_f) ==>
      (filterReceiverGood(__crimp_f, __crimp_r): Bool) &&
      (((recInv(__crimp_r, __crimp_ref): I) in __crimp_f) &&
      (recApply(__crimp_r, (recInv(__crimp_r, __crimp_ref): I)): Ref) ==
      __crimp_ref))
  }

  axiom _smallerF {
    (forall __crimp_f1: Set[I], __crimp_f2: Set[I], __crimp_r: Receiver[I] ::
      { (__crimp_f2 subset __crimp_f1), (filterReceiverGood(__crimp_f1, __crimp_r): Bool) }
      (filterReceiverGood(__crimp_f1, __crimp_r): Bool) &&
      (__crimp_f2 subset __crimp_f1) ==>
      (filterReceiverGood(__crimp_f1, __crimp_r): Bool) &&
      ((__crimp_f2 subset __crimp_f1) &&
      (filterReceiverGood(__crimp_f2, __crimp_r): Bool)))
  }

  axiom _smallerFDelete {
    (forall __crimp_f1: Set[I], __crimp_f2: Set[I], __crimp_r: Receiver[I] ::
      { (filterReceiverGood(__crimp_f1, __crimp_r): Bool), (__crimp_f1 setminus
      __crimp_f2) }
      (filterReceiverGood(__crimp_f1, __crimp_r): Bool) ==>
      (filterReceiverGood(__crimp_f1, __crimp_r): Bool) &&
      (filterReceiverGood((__crimp_f1 setminus __crimp_f2), __crimp_r): Bool))
  }

  axiom _unionF {
    (forall __crimp_f1: Set[I], __crimp_f2: Set[I], __crimp_r: Receiver[I] ::
      { (filterReceiverGood((__crimp_f1 union __crimp_f2), __crimp_r): Bool) }
      (filterReceiverGood((__crimp_f1 union __crimp_f2), __crimp_r): Bool) ==>
      (filterReceiverGood((__crimp_f1 union __crimp_f2), __crimp_r): Bool) &&
      ((filterReceiverGood(__crimp_f1, __crimp_r): Bool) &&
      (filterReceiverGood(__crimp_f2, __crimp_r): Bool)))
  }

  axiom _subsetNotInRefsAxiom {
    (forall __crimp_a: I, __crimp_fs: Set[I], __crimp_r: Receiver[I], __crimp_lostR: Set[Ref] ::
      { (__crimp_a in
      (subsetNotInRefs(__crimp_fs, __crimp_r, __crimp_lostR): Set[I])) }
      (__crimp_a in
      (subsetNotInRefs(__crimp_fs, __crimp_r, __crimp_lostR): Set[I])) ==
      ((__crimp_a in __crimp_fs) &&
      !(((recApply(__crimp_r, __crimp_a): Ref) in __crimp_lostR))))
  }

  axiom _subsetNotInRefsSubset {
    (forall __crimp_fs: Set[I], __crimp_r: Receiver[I], __crimp_lostR: Set[Ref] ::
      { (subsetNotInRefs(__crimp_fs, __crimp_r, __crimp_lostR): Set[I]) }
      ((subsetNotInRefs(__crimp_fs, __crimp_r, __crimp_lostR): Set[I]) subset
      __crimp_fs))
  }

  axiom _idxNotInRefSetAxiom {
    (forall __crimp_a: I, __crimp_recv: Receiver[I], __crimp_domR: Set[Ref] ::
      { (idxNotInRefs(__crimp_a, __crimp_recv, __crimp_domR): Bool) }
      !(((recApply(__crimp_recv, __crimp_a): Ref) in __crimp_domR)) ==>
      (idxNotInRefs(__crimp_a, __crimp_recv, __crimp_domR): Bool))
  }
}

domain Operator[S]  {

  function _noTrigOp(out: S): Bool

  function opApply(op: Operator[S], val1: S, val2: S): S

  function opGetIden(op: Operator[S]): S
}

domain Mapping[V, S]  {

  function mapApply(m: Mapping[V, S], _mInput: V): S

  function mapIdentity(): Mapping[V, V]

  axiom {
    (forall __v: V ::
      { (mapApply((mapIdentity(): Mapping[V, V]), __v): V) }
      (mapApply((mapIdentity(): Mapping[V, V]), __v): V) == __v)
  }
}

domain SetEdit[I]  {

  function setDelete(m: Set[I], e: Set[I]): Set[I]

  function disjUnionEq(s1: Set[I], s2: Set[I], s3: Set[I]): Bool

  axiom _disjUnionEqDef {
    (forall __crimp_s1: Set[I], __crimp_s2: Set[I], __crimp_s3: Set[I] ::
      { (disjUnionEq(__crimp_s1, __crimp_s2, __crimp_s3): Bool) }
      (disjUnionEq(__crimp_s1, __crimp_s2, __crimp_s3): Bool) ==
      ((__crimp_s1 intersection __crimp_s2) == Set[I]() &&
      (__crimp_s1 union __crimp_s2) == __crimp_s3))
  }

  axiom _setDeleteAxiom {
    (forall __crimp_s: Set[I], __crimp_e: Set[I] ::
      { (setDelete(__crimp_s, __crimp_e): Set[I]) }
      (setDelete(__crimp_s, __crimp_e): Set[I]) ==
      (__crimp_s setminus __crimp_e))
  }

  axiom _setDeleteSubset {
    (forall __crimp_s: Set[I], __crimp_e: Set[I] ::
      { (setDelete(__crimp_s, __crimp_e): Set[I]) }
      ((setDelete(__crimp_s, __crimp_e): Set[I]) subset __crimp_s))
  }
}