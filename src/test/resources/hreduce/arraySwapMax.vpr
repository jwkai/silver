field val: Int

domain Array {
  function loc(a: Array, i: Int): Ref
  function len(a: Array): Int
  function first(r: Ref): Array
  function second(r: Ref): Int

  axiom all_diff {
    forall a: Array, i: Int :: {loc(a,i)}
      first(loc(a,i)) == a && second(loc(a,i)) == i
  }

  axiom len_nonneg {
    forall a: Array :: { len(a) }
      len(a) >= 0
  }
}

function max(a: Int, b: Int): Int
  ensures (a <= b ==> result == b) && (a > b ==> result == a)

receiver arrayRec(a: Array) (fun i: Int :: loc(a,i))
filter arrayRange(start: Int, end: Int) (fun i: Int :: i >= start && i < end )
mapping msSingleton() (fun i: Int :: Multiset(i))
operator msSum() (Multiset[Int](), fun a: Multiset[Int], b: Multiset[Int] :: a union b )
operator maxOp() (fun a: Int, b: Int :: max(a,b))

define access_array(a, i, j)
    (forall k: Int :: {k in arrayRange(i,j)} k in arrayRange(i,j) ==> acc(loc(a,k).val))
define toMultiset(a, f) 
    (hreduce[msSum()](msSingleton(arrayRec(a).val) | f))
define preservesMultiset(a, f)
    toMultiset(a, f) == old(toMultiset(a, f))
define maxArray(a, f)   (hreduce[maxOp()](arrayRec(a).val | f))
define preservesMax(a, f) maxArray(a, f) == old(maxArray(a, f))

method swap(a:Array, i: Int, j: Int)
    requires access_array(a,0,len(a))
    requires i in arrayRange(0, len(a)) && j in arrayRange(0, len(a))
    ensures access_array(a,0,len(a))
    ensures preservesMultiset(a, arrayRange(0, len(a)))
    ensures preservesMax(a, arrayRange(0, len(a)))
{
    var temp: Int := loc(a,i).val
    loc(a,i).val := loc(a,j).val
    loc(a,j).val := temp
}