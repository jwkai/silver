
define graph(root,nodes) root in nodes && forall r:Ref :: 
{r in nodes, r.north}{r in nodes, r.south}  //{r in nodes, r.east} {r in nodes, r.west} 
  r in nodes ==> 
    acc(r.north) && acc(r.marked) && acc(r.col) && acc(r.south) && // && acc(r.east) && acc(r.west) 
    (r.north != null ==> r.north in nodes) &&
    (r.south != null ==> r.south in nodes) // &&
    // (r.east != null ==>  r.east  in nodes) &&
    // (r.west != null ==>  r.west  in nodes)

domain Colour {
  function white() : Colour
  function black() : Colour
  function colour(r:Int,g:Int,b:Int) : Colour

  axiom { white() != black() }
}

field north: Ref
field south: Ref
// field east : Ref
// field west : Ref
field marked : Bool
field col : Colour

function boolNegToInt(b: Bool): Int
  ensures (b ==> result == 0) && (!b ==> result == 1)

receiver idrec() (fun r: Ref :: r)
mapping countNot() (fun b: Bool :: boolNegToInt(b))
operator add() (0, fun a: Int, b: Int :: a + b)

define unmarkedCount(f)
    (hreduce[add()](countNot(idrec().marked) | f))

method bfs(x:Ref, s:Set[Ref])
  requires graph(x,s) && forall m : Ref :: {m.marked} m in s ==> !m.marked
  ensures graph(x,s) && x.marked && forall m : Ref :: {m in s, m.north}{m in s, m.south}//{m in s, m.east}{m in s, m.west}
      m in s && m.marked ==> (m.north != null ==> m.north.marked) && (m.south != null ==> m.south.marked) // && (m.east != null ==> m.east.marked) && (m.west != null ==> m.west.marked)
{
  var seen : Set[Ref] := Set(x)
  var todo : Seq[Ref] := Seq(x)

  x.marked := true

  while(|todo| > 0)
    invariant graph(x,s)
    invariant x in seen && seen subset s
    invariant forall m : Ref :: {m.marked} m in seen ==> m.marked
    invariant forall m : Ref :: {m in seen, m.north}{m in seen, m.south}//{m in seen, m.east}{m in seen, m.west}
      m in seen && !(m in todo) ==> (m.north != null ==> m.north.marked) && (m.south != null ==> m.south.marked)
      // && (m.east != null ==> m.east.marked) && (m.west != null ==> m.west.marked)
    invariant forall m : Ref :: {m.marked} m in s && !(m in seen) ==> !m.marked
    invariant forall i : Int :: {todo[i]} 0 <= i < |todo| ==> todo[i] in seen
    // decreases |s setminus seen|, |todo|
  {
    var old_todo: Seq[Ref] := todo
//    assert forall m : Ref :: {m.marked}
//      m in seen && !(m in todo) ==> (m.north != null ==> m.north.marked) && (m.south != null ==> m.south.marked) && (m.east != null ==> m.east.marked) && (m.west != null ==> m.west.marked)
    var n : Ref := todo[0]
    assert n in s

//    assert forall m : Ref :: {m.marked, m.north} {m.marked, m.south} {m.marked, m.east} {m.marked, m.west}
//      m in seen && !(m in todo) ==> (m.north != null ==> m.north.marked) && (m.south != null ==> m.south.marked) && (m.east != null ==> m.east.marked) && (m.west != null ==> m.west.marked)

    // assert n.north != null
    if(n.north != null && !n.north.marked) {
        n.north.marked := true
        todo := todo ++ Seq(n.north)
        assert !(n.north in seen)
        seen := seen union Set(n.north)
    }
    // assert (n.north != null ==> n.north.marked)
    if(n.south != null && !n.south.marked) {
        n.south.marked := true
        todo := todo ++ Seq(n.south)
        seen := seen union Set(n.south)
    }
    // assert (n.south != null ==> n.south.marked)
    // if(n.east != null && !n.east.marked) {
    //     n.east.marked := true
    //     todo := todo ++ Seq(n.east)
    //     seen := seen union Set(n.east)
    // }
    // if(n.west != null && !n.west.marked) {
    //     n.west.marked := true
    //     todo := todo ++ Seq(n.west)
    //     seen := seen union Set(n.west)
    // }    
    todo := todo[1..]
    assert (unmarkedCount(s) < old(unmarkedCount(s))) || 
            ((unmarkedCount(s) == old(unmarkedCount(s))) && (|todo| < |old_todo|))
  }
}

