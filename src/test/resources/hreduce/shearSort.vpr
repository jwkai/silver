field val: Int

domain IntPair {
  function fst(p: IntPair): Int
  function snd(p: IntPair): Int
  function pair(x: Int, y: Int): IntPair

  axiom {
    forall x: Int, y: Int :: {pair(x, y)}
        fst(pair(x, y)) == x
  }

  axiom {
    forall x: Int, y: Int :: {pair(x, y)}
        snd(pair(x, y)) == y
  }
}

domain Matrix {
  function loc(a: Matrix, is: IntPair): Ref
  function len(a: Matrix): Int
  function inv1(r: Ref): Matrix
  function inv2(r: Ref): IntPair

  axiom all_diff {
    forall a: Matrix, is: IntPair :: {loc(a,is)}
      inv1(loc(a,is)) == a && inv2(loc(a,is)) == is
  }

  axiom len_pos {
    forall a: Matrix :: { len(a) }
      len(a) > 0
  }
}

function row(i: Int, col_sz: Int, is: IntPair): Bool {
    fst(is) == i && 0 <= snd(is) < col_sz
}

function col(j: Int, row_sz: Int, is: IntPair): Bool {
    snd(is) == j && 0 <= fst(is) < row_sz
}

function rect(sz: Int, is: IntPair): Bool {
    0 <= fst(is) < sz && 0 <= snd(is) < sz
}

receiver matrixRcv(a: Matrix) (fun is: IntPair :: loc(a,is))
filter matrixIdxAll(sz: Int) (fun is: IntPair :: rect(sz, is))
filter matrixIdxRow(i: Int, sz: Int) (fun is: IntPair :: row(i, sz, is))
filter matrixIdxCol(j: Int, sz: Int) (fun is: IntPair :: col(j, sz, is))
mapping msSingleton() (fun i: Int :: Multiset(i))
operator msSum() ( Multiset[Int](), fun a: Multiset[Int], b: Multiset[Int] :: a union b )

define access_matrix(a)
    (forall is: IntPair :: {is in matrixIdxAll(len(a))} is in matrixIdxAll(len(a)) ==> acc(loc(a,is).val))
define access_matrix_row(a, i)
    (forall is: IntPair :: {is in matrixIdxRow(i,len(a))} is in matrixIdxRow(i,len(a)) ==> acc(loc(a,is).val))
define access_matrix_col(a, j)
    (forall is: IntPair :: {is in matrixIdxCol(j,len(a))} is in matrixIdxCol(j,len(a)) ==> acc(loc(a,is).val))
define toMultiset(a, f) (hreduce[msSum()](msSingleton(matrixRcv(a).val) | f))
define preservesMultiset(a, f) toMultiset(a, f) == old(toMultiset(a, f))

// predicate increasing(a: Array, lo: Int, hi: Int) {
//     lo >= 0 && hi <= len(a) && lo <= hi ==>
//         forall i: Int, j: Int :: {loc(a,i), loc(a,j)}
//             lo <= i && i <= hi &&
//             lo <= j && j <= hi &&
//             i < j ==> loc(a,i).val <= loc(a,j).val
// }

method sortCol(a: Matrix, j: Int)
    requires access_matrix_col(a, j)
    ensures  access_matrix_col(a, j)
    ensures  preservesMultiset(a, matrixIdxCol(j,len(a)))

method sortRow(a: Matrix, i: Int, rev: Bool)
    requires access_matrix_row(a, i)
    ensures  access_matrix_row(a, i)
    ensures  preservesMultiset(a, matrixIdxRow(i,len(a)))

method shearsort(a: Matrix, lo: Int, hi: Int)
	requires access_matrix(a)
    ensures  access_matrix(a)
	ensures  preservesMultiset(a, matrixIdxAll(len(a)))
{
    var loglena: Int
    assume loglena < len(a)
    var k: Int := 0
    while (k < loglena)
        invariant access_matrix(a)
        invariant 0 <= k <= loglena
        invariant preservesMultiset(a, matrixIdxAll(len(a)))
    {
        var i: Int := 0
        while (i < len(a))
            invariant access_matrix(a)
            invariant 0 <= i <= len(a)
            invariant preservesMultiset(a, matrixIdxAll(len(a)))
        {
            assert matrixIdxRow(i,len(a)) subset matrixIdxAll(len(a))
            sortRow(a,i, i % 2 == 0)
        }
        var j: Int := 0
        while (j < len(a))
            invariant access_matrix(a)
            invariant 0 <= j <= len(a)
            invariant preservesMultiset(a, matrixIdxAll(len(a)))
        {
            assert matrixIdxCol(j,len(a)) subset matrixIdxAll(len(a))
            sortCol(a,j)
        }
    }
}