field val: Int

domain Array {
  function loc(a: Array, i: Int): Ref
  function len(a: Array): Int
  function first(r: Ref): Array
  function second(r: Ref): Int

  axiom all_diff {
    forall a: Array, i: Int :: {loc(a,i)}
      first(loc(a,i)) == a && second(loc(a,i)) == i
  }

  axiom len_nonneg {
    forall a: Array :: { len(a) }
      len(a) >= 0
  }
}

receiver arrayRec(a: Array) (fun i: Int :: loc(a, i))
filter allInt(start: Int, end: Int) (fun i: Int :: i >= start && i < end )
operator add() (0, fun a: Int, b: Int :: a + b )

define access_array(a, i1, i2)
    (forall j: Int :: {loc(a, j)} j in allInt(i1, i2) ==> acc(loc(a, j).val))

method arraySum(a: Array) returns (res: Int)
  requires access_array(a, 0, len(a))
  ensures  access_array(a, 0, len(a))
  ensures  res == hreduce[add()](arrayRec(a).val | allInt(0, len(a)))
{
  var n: Int := 0; res := 0
  while (n < len(a))
    invariant access_array(a, 0, len(a))
    invariant 0 <= n && n <= len(a)
    invariant (n == len(a) ==> res == hreduce[add()](arrayRec(a).val | allInt(0, (len(a): Int)))) &&
              (n < len(a)  ==> res == hreduce[add()](arrayRec(a).val | allInt(0, n))) /* I1 */
    // invariant res + hreduce[add()](arrayRec(a).val | allInt(n, len(a))) ==
    //                 hreduce[add()](arrayRec(a).val | allInt(0,len(a))) /* I2 */
  {
    res := res + loc(a, n).val
    n := n + 1
  }
}

// Failing scenarios in the version of ARRAYSUM specified with /*I1*/: 
// Fail 1: we removed the increment of the loop counter n. 
// Fail 2: we planted an off-by-one error in the loop invariant’s comprehension, 
//         changing it to res = 𝖘𝖚𝖒𝑖⦃array[𝑖].val ‖ 0 ≤ 𝑖 < n-1⦄ 
//         (the strict inequality should say 𝑖<n).