          (hreduceApplyM(10, __r, __fs): Int))
      inhale (forall __r: ReduceM[Ref, Bool, Int], __fs: Set[Ref] ::
          { (hreduceApply1M(8, __r, __fs): Int) }
          (hreduceApply1M(8, __r, __fs): Int) ==
          (hreduceApply1M(10, __r, __fs): Int))
      inhale (forall __r: ReduceM[Ref, Bool, Int], __i: Ref ::
          { (rHeapElemM(8, __r, __i): Int) }
          (rHeapElemM(8, __r, __i): Int) == (rHeapElemM(10, __r, __i): Int))
    }
    // 10
    todo := todo[1..]
    // 10
    assert (hreduceApplyM(10, (hreduceM(idrec(), countNot(), add()): ReduceM[Ref, Bool, Int]),
      s): Int) <
      (hreduceApplyM(2, (hreduceM(idrec(), countNot(), add()): ReduceM[Ref, Bool, Int]),
      s): Int) ||
      (hreduceApplyM(10, (hreduceM(idrec(), countNot(), add()): ReduceM[Ref, Bool, Int]),
      s): Int) ==
      (hreduceApplyM(2, (hreduceM(idrec(), countNot(), add()): ReduceM[Ref, Bool, Int]),
      s): Int) &&
      |todo| < |old_todo|
  }
}