domain Colour  {
  
  function white(): Colour 
  
  function black(): Colour 
  
  function colour(r: Int, g: Int, b: Int): Colour 
  
  axiom {
    white() != black()
  }
}

domain ReduceM[A, V, B]  {
  
  function hreduceM(r: Receiver[A], m: Mapping[V, B], op: Operator[B]): ReduceM[A, V, B] 
  
  function hreduceApplyM(rh: Int, c: ReduceM[A, V, B], fs: Set[A]): B 
  
  function hreduceApply1M(rh: Int, c: ReduceM[A, V, B], fs: Set[A]): B 
  
  function hreduceApplyDummyM(a: B): Bool 
  
  function setEqDummyM(b: Bool): Bool 
  
  function getreceiverM(c: ReduceM[A, V, B]): Receiver[A] 
  
  function getoperatorM(c: ReduceM[A, V, B]): Operator[B] 
  
  function getmappingM(c: ReduceM[A, V, B]): Mapping[V, B] 
  
  function rHeapElemM(rh: Int, c: ReduceM[A, V, B], a: A): B 
  
  function triggerDeleteBlockM(applyC: B, block: Set[A]): Bool 
  
  function triggerDeleteKey1M(applyC: B, key: A): Bool 
  
  function exhaleReduceSetM(rh: Int, c: ReduceM[A, V, B], fs: Set[A], fieldID: Int): Bool 
  
  function getFieldIDM(c: ReduceM[A, V, B]): Int 
  
  function skExtM(c: ReduceM[A, V, B], hfA1: B, hfA2: B): A 
  
  function triggerExtM(hfA1: B, hfA2: B): Bool 
  
  axiom applyReduce1EqM {
    (forall __reduce_rh: Int, __reduce_c: ReduceM[A, V, B], __reduce_fs: Set[A] ::
      { (hreduceApplyM(__reduce_rh, __reduce_c, __reduce_fs): B) }
      (hreduceApplyM(__reduce_rh, __reduce_c, __reduce_fs): B) ==
      (hreduceApply1M(__reduce_rh, __reduce_c, __reduce_fs): B))
  }
  
  axiom _invAxReduceM {
    (forall __reduce_r: Receiver[A], __reduce_m: Mapping[V, B], __reduce_o: Operator[B] ::
      { (hreduceM(__reduce_r, __reduce_m, __reduce_o): ReduceM[A, V, B]) }
      (getreceiverM((hreduceM(__reduce_r, __reduce_m, __reduce_o): ReduceM[A, V, B])): Receiver[A]) ==
      __reduce_r &&
      ((getmappingM((hreduceM(__reduce_r, __reduce_m, __reduce_o): ReduceM[A, V, B])): Mapping[V, B]) ==
      __reduce_m &&
      (getoperatorM((hreduceM(__reduce_r, __reduce_m, __reduce_o): ReduceM[A, V, B])): Operator[B]) ==
      __reduce_o))
  }
  
  axiom _emptyReduceM {
    (forall __reduce_rh: Int, __reduce_c: ReduceM[A, V, B], __reduce_fs: Set[A] ::
      { (hreduceApplyM(__reduce_rh, __reduce_c, __reduce_fs): B) }
      __reduce_fs == Set[A]() ==>
      __reduce_fs == Set[A]() &&
      (hreduceApplyM(__reduce_rh, __reduce_c, __reduce_fs): B) ==
      (opGetIden((getoperatorM(__reduce_c): Operator[B])): B))
  }
  
  axiom _singletonM {
    (forall __reduce_rh: Int, __reduce_c: ReduceM[A, V, B], __reduce_elem: A ::
      { (hreduceApplyM(__reduce_rh, __reduce_c, Set(__reduce_elem)): B), (rHeapElemM(__reduce_rh,
      __reduce_c, __reduce_elem): B) }
      (hreduceApplyM(__reduce_rh, __reduce_c, Set(__reduce_elem)): B) ==
      (rHeapElemM(__reduce_rh, __reduce_c, __reduce_elem): B))
  }
  
  axiom _dropOne1M {
    (forall __reduce_rh: Int, __reduce_c: ReduceM[A, V, B], __reduce_fs: Set[A],
    __reduce_key: A ::
      { (triggerDeleteKey1M((hreduceApplyM(__reduce_rh, __reduce_c, __reduce_fs): B),
      __reduce_key): Bool), (rHeapElemM(__reduce_rh, __reduce_c, __reduce_key): B) }
      (__reduce_key in __reduce_fs) ==>
      (__reduce_key in __reduce_fs) &&
      (hreduceApplyM(__reduce_rh, __reduce_c, __reduce_fs): B) ==
      (opApply((getoperatorM(__reduce_c): Operator[B]), (hreduceApply1M(__reduce_rh,
      __reduce_c, (setDelete(__reduce_fs, Set(__reduce_key)): Set[A])): B),
      (rHeapElemM(__reduce_rh, __reduce_c, __reduce_key): B)): B))
  }
  
  axiom _loseManyM {
    (forall __reduce_rh: Int, __reduce_c: ReduceM[A, V, B], __reduce_fs: Set[A],
    __reduce_keys: Set[A] ::
      { (triggerDeleteBlockM((hreduceApplyM(__reduce_rh, __reduce_c, __reduce_fs): B),
      __reduce_keys): Bool) }
      (__reduce_keys subset __reduce_fs) ==>
      (__reduce_keys subset __reduce_fs) &&
      (hreduceApplyM(__reduce_rh, __reduce_c, __reduce_fs): B) ==
      (opApply((getoperatorM(__reduce_c): Operator[B]), (hreduceApply1M(__reduce_rh,
      __reduce_c, (setDelete(__reduce_fs, __reduce_keys): Set[A])): B), (hreduceApply1M(__reduce_rh,
      __reduce_c, __reduce_keys): B)): B))
  }
  
  axiom _setExtEqM {
    (forall __reduce_rh: Int, __reduce_c: ReduceM[A, V, B], __reduce_fs1: Set[A],
    __reduce_fs2: Set[A] ::
      { (hreduceApply1M(__reduce_rh, __reduce_c, __reduce_fs1): B), (hreduceApply1M(__reduce_rh,
      __reduce_c, __reduce_fs2): B) }
      (setEqDummyM(__reduce_fs1 == __reduce_fs2): Bool))
  }
  
  axiom _disjUnionM {
    (forall __reduce_rh: Int, __reduce_c: ReduceM[A, V, B], __reduce_fs1: Set[A],
    __reduce_fs2: Set[A], __reduce_dus: Set[A] ::
      { (hreduceApplyM(__reduce_rh, __reduce_c, __reduce_fs1): B), (hreduceApplyM(__reduce_rh,
      __reduce_c, __reduce_fs2): B), (disjUnionEq(__reduce_fs1, __reduce_fs2,
      __reduce_dus): Bool) }
      (disjUnionEq(__reduce_fs1, __reduce_fs2, __reduce_dus): Bool) ==>
      (hreduceApplyM(__reduce_rh, __reduce_c, __reduce_dus): B) ==
      (opApply((getoperatorM(__reduce_c): Operator[B]), (hreduceApplyM(__reduce_rh,
      __reduce_c, __reduce_fs1): B), (hreduceApplyM(__reduce_rh, __reduce_c,
      __reduce_fs2): B)): B))
  }
  
  axiom _trigExtensionalityM {
    (forall __reduce_rh_old: Int, __reduce_rh_new: Int, __reduce_c: ReduceM[A, V, B],
    __reduce_fs: Set[A] ::
      { (hreduceApplyM(__reduce_rh_old, __reduce_c, __reduce_fs): B), (hreduceApplyM(__reduce_rh_new,
      __reduce_c, __reduce_fs): B) }
      (triggerExtM((hreduceApply1M(__reduce_rh_old, __reduce_c, __reduce_fs): B),
      (hreduceApply1M(__reduce_rh_new, __reduce_c, __reduce_fs): B)): Bool))
  }
  
  axiom _extensionalityM {
    (forall __reduce_rh_old: Int, __reduce_rh_new: Int, __reduce_c: ReduceM[A, V, B],
    __reduce_fs: Set[A] ::
      { (triggerExtM((hreduceApply1M(__reduce_rh_old, __reduce_c, __reduce_fs): B),
      (hreduceApply1M(__reduce_rh_new, __reduce_c, __reduce_fs): B)): Bool) }
      (hreduceApplyM(__reduce_rh_old, __reduce_c, __reduce_fs): B) ==
      (hreduceApplyM(__reduce_rh_new, __reduce_c, __reduce_fs): B) ||
      ((((skExtM(__reduce_c, (hreduceApply1M(__reduce_rh_old, __reduce_c, __reduce_fs): B),
      (hreduceApply1M(__reduce_rh_new, __reduce_c, __reduce_fs): B)): A) in
      __reduce_fs) ==>
      (rHeapElemM(__reduce_rh_old, __reduce_c, (skExtM(__reduce_c, (hreduceApply1M(__reduce_rh_old,
      __reduce_c, __reduce_fs): B), (hreduceApply1M(__reduce_rh_new, __reduce_c,
      __reduce_fs): B)): A)): B) ==
      (rHeapElemM(__reduce_rh_new, __reduce_c, (skExtM(__reduce_c, (hreduceApply1M(__reduce_rh_old,
      __reduce_c, __reduce_fs): B), (hreduceApply1M(__reduce_rh_new, __reduce_c,
      __reduce_fs): B)): A)): B)) ==>
      (hreduceApply1M(__reduce_rh_old, __reduce_c, __reduce_fs): B) ==
      (hreduceApply1M(__reduce_rh_new, __reduce_c, __reduce_fs): B)))
  }
}

domain Receiver[A]  {
  
  function recApply(r: Receiver[A], a: A): Ref 
  
  function recInv(rec: Receiver[A], ref: Ref): A 
  
  function filterReceiverGood(f: Set[A], r: Receiver[A]): Bool 
  
  function subsetNotInRefs(f1: Set[A], r: Receiver[A], lostR: Set[Ref]): Set[A] 
  
  function idxNotInRefs(a: A, r: Receiver[A], domR: Set[Ref]): Bool 
  
  axiom _inverse_receiver {
    (forall __reduce_a: A, __reduce_f: Set[A], __reduce_r: Receiver[A] ::
      { (recApply(__reduce_r, __reduce_a): Ref), (filterReceiverGood(__reduce_f,
      __reduce_r): Bool) }
      { (filterReceiverGood(__reduce_f, __reduce_r): Bool), (__reduce_a in
      __reduce_f) }
      (filterReceiverGood(__reduce_f, __reduce_r): Bool) &&
      (__reduce_a in __reduce_f) ==>
      (filterReceiverGood(__reduce_f, __reduce_r): Bool) &&
      ((__reduce_a in __reduce_f) &&
      (recInv(__reduce_r, (recApply(__reduce_r, __reduce_a): Ref)): A) ==
      __reduce_a))
  }
  
  axiom _inverse_receiver1 {
    (forall __reduce_ref: Ref, __reduce_f: Set[A], __reduce_r: Receiver[A] ::
      { (filterReceiverGood(__reduce_f, __reduce_r): Bool), (recInv(__reduce_r,
      __reduce_ref): A) }
      (filterReceiverGood(__reduce_f, __reduce_r): Bool) &&
      ((recInv(__reduce_r, __reduce_ref): A) in __reduce_f) ==>
      (filterReceiverGood(__reduce_f, __reduce_r): Bool) &&
      (((recInv(__reduce_r, __reduce_ref): A) in __reduce_f) &&
      (recApply(__reduce_r, (recInv(__reduce_r, __reduce_ref): A)): Ref) ==
      __reduce_ref))
  }
  
  axiom _smallerF {
    (forall __reduce_f1: Set[A], __reduce_f2: Set[A], __reduce_r: Receiver[A] ::
      { (__reduce_f2 subset __reduce_f1), (filterReceiverGood(__reduce_f1, __reduce_r): Bool) }
      (filterReceiverGood(__reduce_f1, __reduce_r): Bool) &&
      (__reduce_f2 subset __reduce_f1) ==>
      (filterReceiverGood(__reduce_f1, __reduce_r): Bool) &&
      ((__reduce_f2 subset __reduce_f1) &&
      (filterReceiverGood(__reduce_f2, __reduce_r): Bool)))
  }
  
  axiom _smallerFDelete {
    (forall __reduce_f1: Set[A], __reduce_f2: Set[A], __reduce_r: Receiver[A] ::
      { (filterReceiverGood(__reduce_f1, __reduce_r): Bool), (__reduce_f1 setminus
      __reduce_f2) }
      (filterReceiverGood(__reduce_f1, __reduce_r): Bool) ==>
      (filterReceiverGood(__reduce_f1, __reduce_r): Bool) &&
      (filterReceiverGood((__reduce_f1 setminus __reduce_f2), __reduce_r): Bool))
  }
  
  axiom _unionF {
    (forall __reduce_f1: Set[A], __reduce_f2: Set[A], __reduce_r: Receiver[A] ::
      { (filterReceiverGood((__reduce_f1 union __reduce_f2), __reduce_r): Bool) }
      (filterReceiverGood((__reduce_f1 union __reduce_f2), __reduce_r): Bool) ==>
      (filterReceiverGood((__reduce_f1 union __reduce_f2), __reduce_r): Bool) &&
      ((filterReceiverGood(__reduce_f1, __reduce_r): Bool) &&
      (filterReceiverGood(__reduce_f2, __reduce_r): Bool)))
  }
  
  axiom _subsetNotInRefsAxiom {
    (forall __reduce_a: A, __reduce_fs: Set[A], __reduce_r: Receiver[A], __reduce_lostR: Set[Ref] ::
      { (__reduce_a in
      (subsetNotInRefs(__reduce_fs, __reduce_r, __reduce_lostR): Set[A])) }
      (__reduce_a in
      (subsetNotInRefs(__reduce_fs, __reduce_r, __reduce_lostR): Set[A])) ==
      ((__reduce_a in __reduce_fs) &&
      !(((recApply(__reduce_r, __reduce_a): Ref) in __reduce_lostR))))
  }
  
  axiom _subsetNotInRefsSubset {
    (forall __reduce_fs: Set[A], __reduce_r: Receiver[A], __reduce_lostR: Set[Ref] ::
      { (subsetNotInRefs(__reduce_fs, __reduce_r, __reduce_lostR): Set[A]) }
      ((subsetNotInRefs(__reduce_fs, __reduce_r, __reduce_lostR): Set[A]) subset
      __reduce_fs))
  }
  
  axiom _idxNotInRefSetAxiom {
    (forall __reduce_a: A, __reduce_recv: Receiver[A], __reduce_domR: Set[Ref] ::
      { (idxNotInRefs(__reduce_a, __reduce_recv, __reduce_domR): Bool) }
      !(((recApply(__reduce_recv, __reduce_a): Ref) in __reduce_domR)) ==>
      (idxNotInRefs(__reduce_a, __reduce_recv, __reduce_domR): Bool))
  }
}

domain Operator[B]  {
  
  function _noTrigOp(out: B): Bool 
  
  function opApply(op: Operator[B], val1: B, val2: B): B 
  
  function opGetIden(op: Operator[B]): B 
}

domain Mapping[V, B]  {
  
  function mapApply(m: Mapping[V, B], _mInput: V): B 
  
  function mapIdentity(): Mapping[V, V] 
  
  axiom {
    (forall __v: V ::
      { (mapApply((mapIdentity(): Mapping[V, V]), __v): V) }
      (mapApply((mapIdentity(): Mapping[V, V]), __v): V) == __v)
  }
}

domain SetEdit[A]  {
  
  function setDelete(m: Set[A], e: Set[A]): Set[A] 
  
  function disjUnionEq(s1: Set[A], s2: Set[A], s3: Set[A]): Bool 
  
  axiom _disjUnionEqDef {
    (forall __reduce_s1: Set[A], __reduce_s2: Set[A], __reduce_s3: Set[A] ::
      { (disjUnionEq(__reduce_s1, __reduce_s2, __reduce_s3): Bool) }
      (disjUnionEq(__reduce_s1, __reduce_s2, __reduce_s3): Bool) ==
      ((__reduce_s1 intersection __reduce_s2) == Set[A]() &&
      (__reduce_s1 union __reduce_s2) == __reduce_s3))
  }
  
  axiom _setDeleteAxiom {
    (forall __reduce_s: Set[A], __reduce_e: Set[A] ::
      { (setDelete(__reduce_s, __reduce_e): Set[A]) }
      (setDelete(__reduce_s, __reduce_e): Set[A]) ==
      (__reduce_s setminus __reduce_e))
  }
  
  axiom _setDeleteSubset {
    (forall __reduce_s: Set[A], __reduce_e: Set[A] ::
      { (setDelete(__reduce_s, __reduce_e): Set[A]) }
      ((setDelete(__reduce_s, __reduce_e): Set[A]) subset __reduce_s))
  }
}

domain ___idrec_Receiver_Domain  {
  
  function idrec(): Receiver[Ref] 
  
  axiom {
    (forall r: Ref ::
      { (recApply(idrec(), r): Ref) }
      (recApply(idrec(), r): Ref) == r)
  }
}

domain ___countNot_Mapping_Domain  {
  
  function countNot(): Mapping[Bool, Int] 
  
  axiom {
    (forall b: Bool ::
      { (mapApply(countNot(), b): Int) }
      { boolNegToInt(b) }
      (mapApply(countNot(), b): Int) == boolNegToInt(b))
  }
}

domain ___add_Operator_Domain  {
  
  function add(): Operator[Int] 
  
  axiom {
    (forall a: Int, b: Int ::
      { (opApply(add(), a, b): Int) }
      (opApply(add(), a, b): Int) == a + b)
  }
  
  axiom {
    (opGetIden(add()): Int) == 0
  }
}

field north: Ref

field south: Ref

field east: Ref

field west: Ref

field marked: Bool

field col: Colour

function boolNegToInt(b: Bool): Int
  ensures (b ==> result == 0) && (!b ==> result == 1)


method operator_add_welldef_check()
{
  assert (forall _i1: Int, _i2: Int ::
      { (_noTrigOp((opApply((add(): Operator[Int]), _i1, _i2): Int)): Bool) }
      (opApply((add(): Operator[Int]), _i1, _i2): Int) ==
      (opApply((add(): Operator[Int]), _i2, _i1): Int))
  assert (forall _i1: Int, _i2: Int, _i3: Int ::
      { (_noTrigOp((opApply((add(): Operator[Int]), (opApply((add(): Operator[Int]),
      _i1, _i2): Int), _i3): Int)): Bool) }
      (opApply((add(): Operator[Int]), (opApply((add(): Operator[Int]), _i1,
      _i2): Int), _i3): Int) ==
      (opApply((add(): Operator[Int]), _i1, (opApply((add(): Operator[Int]),
      _i2, _i3): Int)): Int))
  assert (forall _i1: Int ::
      { (_noTrigOp((opApply((add(): Operator[Int]), _i1, (opGetIden((add(): Operator[Int])): Int)): Int)): Bool) }
      (opApply((add(): Operator[Int]), _i1, (opGetIden((add(): Operator[Int])): Int)): Int) ==
      _i1)
}

