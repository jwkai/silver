field val: Int

domain Array {
  function loc(a: Array, i: Int): Ref
  function len(a: Array): Int
  function first(r: Ref): Array
  function second(r: Ref): Int

  axiom all_diff {
    forall a: Array, i: Int :: {loc(a,i)}
      first(loc(a,i)) == a && second(loc(a,i)) == i
  }

  axiom len_nonneg {
    forall a: Array :: { len(a) }
      len(a) >= 0
  }
}

// function max(a: Int, b: Int): Int
//   ensures (a <= b ==> result == b) && (a > b ==> result == a)

receiver arrayRec(a: Array) (fun i: Int :: loc(a,i))
filter intRange(start: Int, end: Int) (fun i: Int :: i >= start && i < end)
filter twoInts(j: Int, k: Int) (fun i: Int :: i == j || i == k)
mapping singleM() (fun i: Int :: Multiset(i))
operator mUnion() (Multiset[Int](), fun a: Multiset[Int], b: Multiset[Int] :: a union b )
// operator maxOp() (fun a: Int, b: Int :: max(a,b))

define access_array(a, i1, i2)
    (forall k: Int :: {loc(a, k)} k in intRange(i1, i2) ==> acc(loc(a, k).val))

// define preserve_array(a, i1, i2)
//     (forall k: Int :: {loc(a, k)} j in allInt(i1, i2) ==> (acc(loc(a, k).val) && loc(a, k).val == old(loc(a, k).val)))

define asMultiset(a, f) (hreduce[mUnion()](singleM(arrayRec(a).val) | f))
define preservesMultiset(a, f) asMultiset(a, f) == old(asMultiset(a, f))
// define maxArray(a)   (hreduce[maxOp()](arrayRec(a).val | intRange(0, len(a))))

// predicate increasing(a: Array, lo: Int, hi: Int) {
//     lo >= 0 && hi <= len(a) && lo <= hi ==>
//         forall i: Int, j: Int :: {loc(a,i), loc(a,j)}
//             lo <= i && i <= hi &&
//             lo <= j && j <= hi &&
//             i < j ==> loc(a,i).val <= loc(a,j).val
// }

// predicate idx_max_in_range(a: Array, idx: Int, lo: Int, hi: Int)
// {
//     access_array(a, 0, len(a)) &&
//     lo >= 0 && hi <= len(a) && lo <= hi && lo <= idx && idx <= hi ==>
//         (forall i: Int :: {loc(a,i)}
//             loc(a,i).val <= loc(a,idx).val)
// }

// predicate idx_min_in_range(a: Array, idx: Int, lo: Int, hi: Int)
// {
//     access_array(a, 0, len(a)) &&
//     lo >= 0 && hi <= len(a) && lo <= hi && lo <= idx && idx <= hi ==>
//         (forall i: Int :: {loc(a,i)}
//             loc(a,i).val >= loc(a,idx).val)
// }

method swap(a: Array, j: Int, k: Int)
    requires acc(loc(a, j).val) && acc(loc(a, k).val)
    requires j in intRange(0, len(a)) && k in intRange(0, len(a))
    ensures acc(loc(a, j).val) && acc(loc(a, k).val)
    ensures preservesMultiset(a, twoInts(j,k))
    // ensures maxArray(a) == old(maxArray(a))
{
    var temp: Int := loc(a,j).val
    loc(a,j).val := loc(a,k).val
    loc(a,k).val := temp
}

method partition(a: Array, lo: Int, hi: Int) returns (p: Int)
    requires 0 <= lo < hi < len(a)
	requires access_array(a, lo, hi)
    ensures access_array(a, lo, hi)
    ensures lo <= p <= hi
	// ensures idx_max_in_range(a, p, lo, p)
    // ensures idx_min_in_range(a, p, p, hi)
	ensures preservesMultiset(a, intRange(lo, hi))
	// ensures maxArray(a) == old(maxArray(a))
{
    // Choose the last element as the pivot
    var pivot: Int := loc(a, hi).val

    // Temporary pivot index
    var j: Int := lo

    var k: Int := lo
    while (j < hi)
        invariant lo <= j <= k
        invariant lo <= k <= hi
        invariant access_array(a, lo, hi)
	    invariant preservesMultiset(a, intRange(lo, hi))
	    // invariant maxArray(a) == old(maxArray(a))
    {
        // If the current element is less than or equal to the pivot
        if (loc(a, k).val <= pivot) {
            // Swap the current element with the element at the temporary pivot index
            swap(a,j,k)
            // Move the temporary pivot index forward
            j := j + 1
        }
        k := k + 1
    }
    // Swap the pivot with the last element
    swap(a,j,hi)
    p := j // the pivot index
}

method quicksort(a: Array, lo: Int, hi: Int)
	requires access_array(a, lo, hi)
    ensures  access_array(a, lo, hi)
    // ensures  INCREASING(a, lo, hi)
	ensures preservesMultiset(a, intRange(lo, hi))
	// ensures  maxArray(a) == old(maxArray(a))
{
    if (0 <= lo < hi < len(a)) {
		var p: Int := partition(a, lo, hi)
		quicksort(a, lo, p-1)
		quicksort(a, p+1, hi)
	}
}