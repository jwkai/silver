// Calls to components with the wrong number of arguments, in a crimp expression and in a component body.
field val: Int
field flag: Bool

domain Array {
  function loc(a: Array, i: Int): Ref
  function len(a: Array): Int
  function first(r: Ref): Array
  function second(r: Ref): Int
  axiom all_diff { forall a: Array, i: Int :: {loc(a,i)} first(loc(a,i)) == a && second(loc(a,i)) == i }
  axiom len_nonneg { forall a: Array :: { len(a) } len(a) >= 0 }
}

function allInt(start: Int, end: Int): Set[Int]
  ensures (forall i: Int :: { i in result } (i in result) == (i >= start && i < end))
function isB(b: Bool): Bool

define access_array(a, i1, i2) (forall j: Int :: {loc(a, j)} j in allInt(i1, i2) ==> acc(loc(a, j).val) && acc(loc(a, j).flag))


receiver arrayRec(a: Array) (fun (i: Int) : Ref :: loc(a, i))
operator add() (fun (a: Int, b: Int) : Int :: a + b, 0)
function useMap(mp: Mapping[Int, Int]): Int
function useOp(o: Operator[Int]): Int
mapping twice() (fun (i: Int) : Int :: 2 * i)
mapping thrice() (fun (i: Int) : Int :: 3 * i + useMap(twice(1)))
method m(a: Array) returns (x: Int)
  requires access_array(a, 0, len(a))
{ x := crimp[add(1)][twice(arrayRec(a).val)](allInt(0, len(a))) }
